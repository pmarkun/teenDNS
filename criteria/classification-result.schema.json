{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teendns.local/schema/classification-result-v1.json",
  "title": "Resultado de classificação indicativa teenDNS",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taxonomy_version",
    "profile_id",
    "subject",
    "rating",
    "criteria",
    "decision",
    "review_status",
    "classified_at"
  ],
  "properties": {
    "taxonomy_version": {"type": "string", "const": "1.0.0"},
    "profile_id": {"type": "string", "const": "br-12-13-v1"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "scope"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "scope": {"enum": ["domain", "site", "page", "feature"]},
        "feature": {"type": "string"}
      }
    },
    "rating": {"enum": ["L", "6", "10", "12", "14", "16", "18", "unknown"]},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "criterion_id", "label", "confidence", "evidence"],
        "properties": {
          "axis": {"enum": ["violence", "sex_nudity", "drugs", "interactivity"]},
          "criterion_id": {"type": "string", "pattern": "^[A-D]\\.[1-7]\\.[0-9]+$"},
          "label": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "description"],
              "properties": {
                "kind": {"enum": ["text", "image", "audio", "video", "metadata", "behavior", "source_list"]},
                "description": {"type": "string", "minLength": 1},
                "locator": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "contexts": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["educational", "journalistic", "scientific", "health", "prevention", "fictional", "satirical", "promotion", "glamorization", "instruction", "commercial_exploitation"]}
    },
    "decision": {"enum": ["allow", "observe", "mediate", "protect"]},
    "decision_reasons": {"type": "array", "items": {"type": "string"}},
    "review_status": {"enum": ["machine_suggestion", "human_reviewed", "contested", "superseded"]},
    "classified_at": {"type": "string", "format": "date-time"},
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    }
  }
}
