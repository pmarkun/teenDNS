{
  "listen": ":853",
  "upstream": "unbound:5353",
  "certificate": "/runtime/certs/server.pem",
  "private_key": "/runtime/certs/server-key.pem",
  "max_ttl": 300,
  "profiles": [
    {
      "id": "ana",
      "label": "Casa",
      "hostname": "p-ana.dns.teendns.test",
      "default_action": "allow",
      "version": 1,
      "rules": [
        {
          "domain": "blocked.test",
          "include_subdomains": true,
          "action": "block",
          "category": "gambling",
          "reason": "Categoria bloqueada no perfil da Ana"
        },
        {
          "domain": "school.blocked.test",
          "action": "allow",
          "category": "education",
          "reason": "Exceção escolar mais específica"
        },
        {
          "domain": "adult.test",
          "include_subdomains": true,
          "action": "block",
          "category": "adult",
          "reason": "Conteúdo adulto protegido pelo acordo da família"
        },
        {
          "domain": "tracking.test",
          "include_subdomains": true,
          "action": "observe",
          "category": "tracking",
          "reason": "Observar serviços que acompanham atividade entre sites"
        },
        {
          "domain": "youtube.com",
          "include_subdomains": true,
          "action": "allow",
          "reason": "Permitido pelo acordo da família"
        }
      ]
    },
    {
      "id": "bia",
      "label": "Estudos",
      "hostname": "p-bia.dns.teendns.test",
      "default_action": "allow",
      "version": 1,
      "rules": []
    }
  ]
}
